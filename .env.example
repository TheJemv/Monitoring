# Copia este archivo a .env y ajusta los valores a tu servidor.
# Cuando tengas dominios, reemplaza la IP por el dominio correspondiente
# (ej. EXPO_PUBLIC_PROMETHEUS_URL=https://prometheus.tudominio.com).

EXPO_PUBLIC_SERVER_HOST=192.168.0.69

EXPO_PUBLIC_PROMETHEUS_URL=http://192.168.0.69:9090
EXPO_PUBLIC_NODE_EXPORTER_URL=http://192.168.0.69:9100
EXPO_PUBLIC_CADVISOR_URL=http://192.168.0.69:8080

# Portainer (tab de Docker). Opcional hasta que lo agregues al servidor.
EXPO_PUBLIC_PORTAINER_URL=http://192.168.0.69:9000
EXPO_PUBLIC_PORTAINER_API_TOKEN=
